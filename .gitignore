# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# Next.js
/.next/
/out/
/build
next-env.d.ts

# Production
/dist

# Environment & secrets: NEVER commit these
.env
.env.*
!.env.example

# Supabase
/supabase/.temp
/supabase/.branches

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript
*.tsbuildinfo

# Testing / coverage
/coverage

# Pipeline scratchpads (regenerated on each /ship or /fix; old runs move to .pipeline/archive/).
# Remove the three lines below if you want to commit spec/changelog/verdict, screenshots, and their archive as an audit trail.
.pipeline/*.md
.pipeline/shots/
.pipeline/archive/
